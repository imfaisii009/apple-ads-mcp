# Apple Ads Platform API MCP — environment template
#
# Copy this file to `.env` and fill in your real values.
# NEVER commit your real .env file or your Apple .p8 private key — both are
# already covered by .gitignore, keep it that way.
#
# Where these come from: Apple Ads UI → Settings → API. Create an API key,
# then download the .p8 private key (shown once) and copy the three IDs.

# The Client ID from the Apple Ads API key page.
# APPLE_ADS_CLIENT_ID=SEARCHADS.27478e17-3fdb-4d47-8b93-e5b0f88e6ce5

# The Team ID from the Apple Ads API key page.
# APPLE_ADS_TEAM_ID=SEARCHADS.27478e17-3fdb-4d47-8b93-e5b0f88e6ce5

# The Key ID from the Apple Ads API key page.
# APPLE_ADS_KEY_ID=a1b2c3d4-1234-5678-90ab-cdef12345678

# Absolute path to the downloaded private key (.p8 / PEM PKCS#8).
# Use this or APPLE_ADS_PRIVATE_KEY below, not both.
# APPLE_ADS_PRIVATE_KEY_PATH=/ABS/PATH/to/PrivateKey.p8

# Optional: the private key contents inline (PEM), for environments where
# writing a key file to disk isn't possible (e.g. CI secrets).
# APPLE_ADS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional but recommended: default ad account (org) ID. Sent as the
# `X-Ap-Context: adAccountId=<id>;` header on every call that needs it.
# Discover valid values by calling the `me` / ad-accounts operations first.
# APPLE_ADS_AD_ACCOUNT_ID=1234567

# Optional: override the API base URL. Defaults to https://api.ads.apple.com/v1
# APPLE_ADS_BASE_URL=https://api.ads.apple.com/v1

# Optional: override the OAuth token host. Defaults to https://appleid.apple.com
# APPLE_ADS_AUTH_BASE_URL=https://appleid.apple.com

# Optional: set to "true" to expose every generated operation as its own MCP
# tool instead of the 4 token-efficient meta-tools. Off by default.
# APPLE_ADS_EXPOSE_ALL_TOOLS=false
